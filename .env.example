# Copie este arquivo para .env (dev local) e preencha com as chaves reais.
# Nunca commite o .env de verdade — ele já está no .gitignore.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: só usar em código de servidor (nunca expor com NEXT_PUBLIC_).
# Necessária para operações administrativas que ignoram RLS (ex.: scripts de seed).
SUPABASE_SERVICE_ROLE_KEY=

# --- Banco de dados (Drizzle) ---
# Connection pooler do Supabase (porta 6543, modo "transaction") — usar em runtime
# serverless/edge (Vercel). Project Settings > Database > Connection string > Transaction pooler.
# Se você instalou a integração nativa Vercel↔Supabase, ela já cria uma variável
# equivalente chamada POSTGRES_URL — o código aceita os dois nomes, não precisa duplicar.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Conexão direta (porta 5432) — usar só para rodar migrations localmente (npm run db:migrate).
# Equivalente da integração nativa: POSTGRES_URL_NON_POOLING (também aceito pelo código).
DIRECT_DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --- E-mail transacional (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL="Fidgets <pedidos@seudominio.com.br>"

# --- Pagamento (Woovi) ---
# Woovi > Configurações > Aplicações > criar AppID. A verificação de
# assinatura do webhook usa a chave pública da própria Woovi (fixa no código,
# não precisa de env var — ver src/features/payments/woovi.ts). Configure a
# URL do webhook no painel da Woovi apontando para:
# https://SEU-DOMINIO/api/webhooks/woovi
WOOVI_APP_ID=

# --- Pagamento (Asaas) — Fase 3, deixar em branco por enquanto ---
ASAAS_API_KEY=

# --- Frete (Superfrete) — Fase 2, deixar em branco por enquanto ---
SUPERFRETE_API_TOKEN=
# CEP de origem usado na cotação até /admin/configuracoes ter um endereço
# salvo (a coluna storeSettings.zipCode tem prioridade quando preenchida).
SUPERFRETE_ORIGIN_ZIP_CODE=

# URL pública do site, usada para montar links absolutos (ex.: link de rastreio no e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
